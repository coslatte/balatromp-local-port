    <!-- Manual -->
    <string name="manual_what_title">What this app does</string>
    <string name="manual_what_desc">Replaces Termux + Node.js. Starts a native Ktor server on your phone (port 8788) and automatically writes the IP into Multiplayer.jkr so Balatro connects over LAN without editing files manually.</string>
    <string name="manual_flow_title">Host / Client flow</string>
    <string name="manual_flow_host_title">Host</string>
    <string name="manual_flow_host_desc">1) Enable hotspot on this phone. 2) Tap “Host &amp; Play” → starts server, injects http://YOUR_IP:8788 into Multiplayer.jkr and launches Balatro. 3) Inside Balatro Multiplayer create the lobby.</string>
    <string name="manual_flow_client_title">Client</string>
    <string name="manual_flow_client_desc">1) Connect to the host hotspot. 2) Enter host IP (e.g. 10.2.0.2) and tap “Join &amp; Play”. 3) Same URL is injected and Balatro launches. 4) In Balatro join the host lobby.</string>
    <string name="manual_ip_title">Is 10.2.0.2 correct?</string>
    <string name="manual_ip_desc">Yes. It is your ap0 (hotspot) interface IP. If this phone creates the hotspot and the other phone connects to it, put 10.2.0.2 in client mode. Both need the same multiplayer mod. Then in-game host creates lobby and client joins via room code.</string>
    <string name="manual_network_title">Network requirements</string>
    <string name="manual_network_desc">Same LAN/hotspot, same Balatro mod version, port 8788 free, and folder access granted (Shizuku recommended).</string>
    <string name="manual_shizuku_title">Why Shizuku?</string>
    <string name="manual_shizuku_desc">Android 11+ blocks Android/data. Shizuku grants ADB-level access without root. Once set up (install Shizuku, enable wireless debugging and authorize), the app writes Multiplayer.jkr without folder picker.</string>
    <string name="manual_trouble_title">Common issues</string>
    <string name="manual_trouble_desc">If it does not connect: check same network, correct IP (see “Your local IP”), host tapped first, port 8788 not blocked and same mod on both phones.</string>
    <string name="manual_close">Got it</string>
    <string name="credit">Created by Gabriel Paz</string>
    <string name="credit_github_desc">Open creator GitHub</string>
