    <!-- Manual - direct & colloquial -->
    <string name="manual_what_title">What does it do?</string>
    <string name="manual_what_desc">Play Balatro with friends without Termux. The app starts the server and sets up Multiplayer.jkr for you. Just host or join.</string>
    <string name="manual_flow_title">How to play</string>
    <string name="manual_flow_host_title">You host</string>
    <string name="manual_flow_host_desc">Hotspot on → “Host &amp; Play” → Balatro → create room.</string>
    <string name="manual_flow_client_title">You join</string>
    <string name="manual_flow_client_desc">Connect to hotspot → enter host IP (e.g. 10.2.0.2) → “Join &amp; Play” → join room in Balatro.</string>
    <string name="manual_ip_title">Is 10.2.0.2 normal?</string>
    <string name="manual_ip_desc">Yep. That is the hotspot IP. Copy it as-is on the other phone.</string>
    <string name="manual_network_title">What you need</string>
    <string name="manual_network_desc">Same network + same mod on both phones. That is it.</string>
    <string name="manual_shizuku_title">Shizuku?</string>
    <string name="manual_shizuku_desc">Permission to touch Android/data. One-time setup, 1 min and done.</string>
    <string name="manual_trouble_title">Not connecting?</string>
    <string name="manual_trouble_desc">Same network, same IP, host first, same mod. Check technical details if stuck.</string>
    <string name="manual_close">Got it</string>
    <string name="credit">Created by Gabriel Paz</string>
    <string name="credit_github_desc">Open creator GitHub</string>

