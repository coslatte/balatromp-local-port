    <!-- Manual - directo y coloquial -->
    <string name="manual_what_title">¿Qué hace?</string>
    <string name="manual_what_desc">Juega Balatro con amigos sin Termux. La app levanta el servidor y configura Multiplayer.jkr por ti. Tú solo eliges crear o unirte.</string>
    <string name="manual_flow_title">Cómo se juega</string>
    <string name="manual_flow_host_title">Tú creas la partida</string>
    <string name="manual_flow_host_desc">Hotspot en este móvil → “Crear y jugar” → Balatro → crea sala.</string>
    <string name="manual_flow_client_title">Te unes a un amigo</string>
    <string name="manual_flow_client_desc">Conéctate a su hotspot → pon su IP (ej. 10.2.0.2) → “Unirse y jugar” → únete a su sala en Balatro.</string>
    <string name="manual_ip_title">¿10.2.0.2 es normal?</string>
    <string name="manual_ip_desc">Sí. Es la IP del hotspot. La copias tal cual en el móvil del amigo.</string>
    <string name="manual_network_title">Qué necesitas</string>
    <string name="manual_network_desc">Misma red y mismo mod en los dos móviles. Nada más.</string>
    <string name="manual_shizuku_title">¿Shizuku?</string>
    <string name="manual_shizuku_desc">Permiso para tocar Android/data. Se configura una vez en 1 min y te olvidas.</string>
    <string name="manual_trouble_title">¿No conecta?</string>
    <string name="manual_trouble_desc">Misma red, misma IP, host primero, mismo mod. Si falla, revisa detalles técnicos.</string>
    <string name="manual_close">Entendido</string>
    <string name="credit">Creado por Gabriel Paz</string>
